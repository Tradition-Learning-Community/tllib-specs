    {"test_id": "DYN-003-UNKNOWN-SOURCE", "applies_to": "PRESERVE-STOCHASTIC-EXPRESSION", "category": "error", "given": "An unknown source or symbol identifier.", "when": "Validation is performed.", "expect": {"error_code": "UNKNOWN_SOURCE_IDENTIFIER", "result_absent": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-003/oracle.yaml"]},
    {"test_id": "DYN-003-UNRESOLVED", "applies_to": "PRESERVE-STOCHASTIC-EXPRESSION", "category": "preservation", "given": "A valid structural request.", "when": "The result is returned.", "expect": {"unresolved": ["catalogue_blocked_locally", "stochastic_semantics"]}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-003/oracle.yaml", "registry/domain-finalization/dynamics/decision-required.yaml"]},
    {"test_id": "DYN-003-ROUND-TRIP", "applies_to": "PRESERVE-STOCHASTIC-EXPRESSION", "category": "serialization", "given": "A valid record is serialized and reconstructed losslessly.", "when": "The round trip completes.", "expect": {"expression_unchanged": true, "local_block_unchanged": true, "traceability_unchanged": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-003/oracle.yaml"]},
    {"test_id": "DYN-003-DETERMINISM", "applies_to": "PRESERVE-STOCHASTIC-EXPRESSION", "category": "determinism", "given": "Identical opaque inputs.", "when": "The operation is repeated.", "expect": {"structurally_identical_record": true, "seed_not_used": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-003/oracle.yaml"]},
    {"test_id": "DYN-003-METAMORPHIC-HANDLE", "applies_to": "PRESERVE-STOCHASTIC-EXPRESSION", "category": "preservation", "given": "The opaque carrier payload is replaced while source IDs are retained.", "when": "The transformed expression is preserved.", "expect": {"only_payload_changes": true, "block_status_unchanged": true, "source_links_unchanged": true, "unresolved_unchanged": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-003/oracle.yaml"]},
