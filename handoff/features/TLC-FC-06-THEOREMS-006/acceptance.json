{
  "schema_version": "1.0", "package_version": "1.0.0", "applies_to": "TLC-FC-06-THEOREMS-006",
  "tests": [
    {"test_id": "THEOREMS-006-A01", "applies_to": "INDEX-THEOREM-DECLARATIONS", "category": "valid_input", "given": "Six unique declarations with registered sources and the exact required proof statuses.", "when": "The index is constructed.", "expect": "An exact six-entry index addressable by scientific object identifier.", "source_basis": ["registry/oracles/theorems/TLC-FC-06-THEOREMS-006/oracle.yaml"]},
    {"test_id": "THEOREMS-006-A02", "applies_to": "INDEX-THEOREM-DECLARATIONS", "category": "error", "given": "A duplicate theorem identifier.", "when": "Construction validation runs.", "expect": {"error": "DUPLICATE_THEOREM_ID", "partial_result": false}},
    {"test_id": "THEOREMS-006-A03", "applies_to": "INDEX-THEOREM-DECLARATIONS", "category": "error", "given": "A covered declaration lacks proof status.", "when": "Construction validation runs.", "expect": {"error": "MISSING_PROOF_STATUS", "partial_result": false}},
    {"test_id": "THEOREMS-006-A04", "applies_to": "INDEX-THEOREM-DECLARATIONS", "category": "error", "given": "A declaration uses an uncovered identifier or an unregistered source.", "when": "Construction validation runs.", "expect": {"error": "UNKNOWN_THEOREM_ID", "partial_result": false}},
    {"test_id": "THEOREMS-006-A05", "applies_to": "LOOKUP-THEOREM-DECLARATION", "category": "error", "given": "A lookup identifier outside the covered set.", "when": "Lookup is invoked.", "expect": {"error": "UNKNOWN_THEOREM_ID", "partial_result": false}},
    {"test_id": "THEOREMS-006-A06", "applies_to": "TLC-FC-06-THEOREMS-006", "category": "preservation", "given": "The exact six source-declared statuses.", "when": "Index and lookup results are inspected.", "expect": {"TLC-SO-THEOREMS-002": "partial", "TLC-SO-THEOREMS-003": "partial", "TLC-SO-THEOREMS-004": "partial", "TLC-SO-THEOREMS-008": "partial", "TLC-SO-THEOREMS-009": "absent", "TLC-SO-THEOREMS-010": "partial", "complete_count": 0}},
    {"test_id": "THEOREMS-006-A07", "applies_to": "LOOKUP-THEOREM-DECLARATION", "category": "preservation", "given": "A covered declaration with opaque hypotheses, conclusion, source, proof status, and quantifier status.", "when": "Exact lookup is performed.", "expect": "All metadata is unchanged; RESULT-THEOREMS-002 and 003 retain one explicit quantifier and the other indexed result quantifiers remain unspecified."},
    {"test_id": "THEOREMS-006-A08", "applies_to": "TLC-FC-06-THEOREMS-006", "category": "determinism", "given": "Identical construction and lookup inputs.", "when": "Both operations are repeated.", "expect": "Semantically identical index and lookup results."},
    {"test_id": "THEOREMS-006-A09", "applies_to": "TLC-FC-06-THEOREMS-006", "category": "unsupported_operation", "given": "A request to prove, disprove, verify, promote, or return a truth value.", "when": "The package boundary is exercised.", "expect": "No proof execution, promotion, synthesis, or truth value is produced."}
  ]
}
