{
  "schema_version": "1.0", "package_version": "1.0.0",
  "feature": {"feature_id": "TLC-FC-06-THEOREMS-006", "title": "Theorem declaration index", "domain": "theorems"},
  "purpose": "Construct and query an exact six-declaration theorem index while preserving source statements, quantifier metadata, and five partial plus one absent proof status without theorem evaluation.",
  "scope": {
    "required": [
      {"id": "TH006-REQ-001", "statement": "Index exactly TLC-SO-THEOREMS-002, 003, 004, 008, 009, and 010, each once with its registered source."},
      {"id": "TH006-REQ-002", "statement": "Preserve the exact proof-status map: five partial declarations and TLC-SO-THEOREMS-009 absent."},
      {"id": "TH006-REQ-003", "statement": "Support exact identifier lookup returning unchanged declaration metadata and no truth value."},
      {"id": "TH006-REQ-004", "statement": "Preserve explicit one-quantifier status for RESULT-THEOREMS-002 and RESULT-THEOREMS-003 and unspecified status for the remaining indexed results."}
    ],
    "forbidden": [
      {"id": "TH006-FOR-001", "statement": "Do not prove, disprove, verify proof correctness, promote proof status, or synthesize missing declaration content."},
      {"id": "TH006-FOR-002", "statement": "Do not return true, false, proved, or disproved from construction or lookup."},
      {"id": "TH006-FOR-003", "statement": "Do not fall back from an unknown or incorrectly sourced identifier to a similar declaration."}
    ],
    "deferred": [
