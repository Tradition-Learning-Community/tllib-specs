  "applies_to": "TLC-FC-11-CAPACITIES-001",
  "tests": [
    {"test_id": "CAP-001-NOMINAL", "applies_to": "BUILD-CAPACITY-CONSTRAINT-RECORD-AND-VERIFY-REQUIRED-SYMBOLS", "category": "valid_input", "given": {"feature_id": "TLC-FC-11-CAPACITIES-001", "object_ids": ["TLC-SO-CAPACITIES-013", "TLC-SO-CAPACITIES-064"], "complete_provenance": true}, "when": "The structural operation is invoked.", "expect": {"artifact_kind": "CapacityPrototypeDescriptor", "structurally_valid": true, "object_order_preserved": true}, "source_basis": ["registry/oracles/capacities/TLC-FC-11-CAPACITIES-001/oracle.yaml"]},
    {"test_id": "CAP-001-UNKNOWN-FEATURE", "applies_to": "BUILD-CAPACITY-CONSTRAINT-RECORD-AND-VERIFY-REQUIRED-SYMBOLS", "category": "error", "given": {"feature_id": "other"}, "when": "Identity validation runs.", "expect": {"error": "UnknownFeatureId", "partial_result": false}, "source_basis": ["registry/oracles/capacities/TLC-FC-11-CAPACITIES-001/oracle.yaml"]},
    {"test_id": "CAP-001-MISSING-OBJECT", "applies_to": "BUILD-CAPACITY-CONSTRAINT-RECORD-AND-VERIFY-REQUIRED-SYMBOLS", "category": "error", "given": {"missing_object": "TLC-SO-CAPACITIES-064"}, "when": "Coverage validation runs.", "expect": {"error": "MissingCoveredObject", "partial_result": false}, "source_basis": ["registry/test-plans/TLC-FC-11-CAPACITIES-001/test-plan.yaml"]},
    {"test_id": "CAP-001-DUPLICATE-OBJECT", "applies_to": "BUILD-CAPACITY-CONSTRAINT-RECORD-AND-VERIFY-REQUIRED-SYMBOLS", "category": "error", "given": {"duplicate_object": "TLC-SO-CAPACITIES-013"}, "when": "Coverage validation runs.", "expect": {"error": "DuplicateCoveredObject", "partial_result": false}, "source_basis": ["registry/test-plans/TLC-FC-11-CAPACITIES-001/test-plan.yaml"]},
    {"test_id": "CAP-001-MISSING-PROVENANCE", "applies_to": "BUILD-CAPACITY-CONSTRAINT-RECORD-AND-VERIFY-REQUIRED-SYMBOLS", "category": "error", "given": {"missing_source_reference": true}, "when": "Provenance validation runs.", "expect": {"error": "MissingSourceReference", "partial_result": false}, "source_basis": ["registry/oracles/capacities/TLC-FC-11-CAPACITIES-001/oracle.yaml"]},
    {"test_id": "CAP-001-OPAQUE-PRESERVATION", "applies_to": "BUILD-CAPACITY-CONSTRAINT-RECORD-AND-VERIFY-REQUIRED-SYMBOLS", "category": "preservation", "given": {"opaque_payloads": true}, "when": "Payloads round-trip through the operation.", "expect": {"payload_identity_preserved": true, "evaluated": false}, "source_basis": ["registry/oracles/capacities/TLC-FC-11-CAPACITIES-001/oracle.yaml"]},
    {"test_id": "CAP-001-FORBIDDEN-EVALUATION", "applies_to": "BUILD-CAPACITY-CONSTRAINT-RECORD-AND-VERIFY-REQUIRED-SYMBOLS", "category": "unsupported_operation", "given": {"scientific_evaluation_requested": true}, "when": "The request is validated.", "expect": {"error": "ScientificEvaluationRequested", "partial_result": false}, "source_basis": ["registry/oracles/capacities/TLC-FC-11-CAPACITIES-001/oracle.yaml"]},
    {"test_id": "CAP-001-DETERMINISM", "applies_to": "BUILD-CAPACITY-CONSTRAINT-RECORD-AND-VERIFY-REQUIRED-SYMBOLS", "category": "determinism", "given": {"identical_structural_inputs": true}, "when": "The operation is repeated.", "expect": {"structurally_identical_outputs": true}, "source_basis": ["registry/algorithms/capacities/TLC-FC-11-CAPACITIES-001/algorithm.yaml"]}
  ]
