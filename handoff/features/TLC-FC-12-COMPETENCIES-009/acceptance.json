    {"test_id": "C009-META-001", "applies_to": "BUILD-COMPETENCIES-DESCRIPTOR-009", "category": "preservation", "given": "Caller map order is permuted.", "when": "A descriptor is emitted.", "expect": "Output order remains [022, 035, 085].", "source_basis": ["registry/oracles/competencies/TLC-FC-12-COMPETENCIES-009/oracle.yaml"]},
    {"test_id": "C009-DET-001", "applies_to": "BUILD-COMPETENCIES-DESCRIPTOR-009", "category": "determinism", "given": "Identical structural inputs.", "when": "The operation is repeated.", "expect": "Semantically identical descriptors.", "source_basis": ["registry/oracles/competencies/TLC-FC-12-COMPETENCIES-009/oracle.yaml"]},
    {"test_id": "C009-REJ-001", "applies_to": "BUILD-COMPETENCIES-DESCRIPTOR-009", "category": "unsupported_operation", "given": "A request for cognitive-load metric, insight, or mastery-index value.", "when": "The package boundary is exercised.", "expect": {"error": "ScientificEvaluationRequested", "partial_result": false}, "source_basis": ["registry/oracles/competencies/TLC-FC-12-COMPETENCIES-009/oracle.yaml"]},
    {"test_id": "C009-REJ-002", "applies_to": "BUILD-COMPETENCIES-DESCRIPTOR-009", "category": "unsupported_operation", "given": "A request for score, level, rank, threshold, or diagnosis.", "when": "The package boundary is exercised.", "expect": {"error": "ScientificEvaluationRequested", "partial_result": false}, "source_basis": ["registry/oracles/competencies/TLC-FC-12-COMPETENCIES-009/oracle.yaml"]},
    {"test_id": "C009-TRACE-001", "applies_to": "TLC-FC-12-COMPETENCIES-009", "category": "preservation", "given": "The package traceability chain.", "when": "References are resolved.", "expect": "All source and finalized artifacts form one consistent feature chain.", "source_basis": ["registry/oracles/competencies/TLC-FC-12-COMPETENCIES-009/oracle.yaml"]}
