    {"test_id": "C009-TYPE-001", "applies_to": "BUILD-COMPETENCIES-DESCRIPTOR-009", "category": "invariant", "given": "Source objects typed Metric.", "when": "A descriptor is emitted.", "expect": "Metric remains descriptive and is not promoted to executable Measurement semantics.", "source_basis": ["registry/oracles/competencies/TLC-FC-12-COMPETENCIES-009/oracle.yaml"]},
    {"test_id": "C009-MAST-001", "applies_to": "BUILD-COMPETENCIES-DESCRIPTOR-009", "category": "invariant", "given": "The mastery-index source reference.", "when": "A descriptor is emitted.", "expect": "The reference remains opaque and no mastery index is produced.", "source_basis": ["registry/oracles/competencies/TLC-FC-12-COMPETENCIES-009/oracle.yaml"]},
