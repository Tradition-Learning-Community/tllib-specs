    {"test_id": "C009-ERR-001", "applies_to": "BUILD-COMPETENCIES-DESCRIPTOR-009", "category": "error", "given": "An unlisted metric object is supplied.", "when": "Membership is validated.", "expect": {"error": "UnexpectedCoveredObject", "partial_result": false}, "source_basis": ["registry/oracles/competencies/TLC-FC-12-COMPETENCIES-009/oracle.yaml"]},
