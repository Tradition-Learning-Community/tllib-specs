{
  "schema_version": "1.0", "package_version": "1.0.0", "applies_to": "TLC-FC-05-DYNAMICS-006",
  "tests": [
    {"test_id": "DYN-006-NOMINAL", "applies_to": "CONSTRUCT-OPAQUE-STATE-CANDIDATE-RECORD", "category": "valid_input", "given": "Opaque values keyed by covered ScientificObjectIds.", "when": "The candidate operation is requested.", "expect": {"representation": "StateCandidateRecord", "all_supplied_pairs_retained": true, "per_component_traceability": true, "completeness": "unasserted"}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-006/oracle.yaml", "registry/test-plans/TLC-FC-05-DYNAMICS-006/test-plan.yaml"]},
    {"test_id": "DYN-006-PARTIAL-CANDIDATE", "applies_to": "CONSTRUCT-OPAQUE-STATE-CANDIDATE-RECORD", "category": "valid_input", "given": "Any valid subset of the twelve covered components.", "when": "The candidate is constructed.", "expect": {"subset_preserved_exactly": true, "omitted_components_absent": true, "defaults_absent": true, "completeness_claim_absent": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-006/oracle.yaml"]},
    {"test_id": "DYN-006-EMPTY-CANDIDATE", "applies_to": "CONSTRUCT-OPAQUE-STATE-CANDIDATE-RECORD", "category": "boundary", "given": "An empty valid mapping.", "when": "The candidate is constructed.", "expect": {"empty_record_returned": true, "state_space": "undefined", "completeness": "unasserted"}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-006/oracle.yaml"]},
    {"test_id": "DYN-006-UNKNOWN-COMPONENT", "applies_to": "CONSTRUCT-OPAQUE-STATE-CANDIDATE-RECORD", "category": "error", "given": "A component key outside the covered identifier set.", "when": "Validation is performed.", "expect": {"error_code": "UNKNOWN_SOURCE_IDENTIFIER", "result_absent": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-006/oracle.yaml"]},
    {"test_id": "DYN-006-TYPE-SHAPE", "applies_to": "CONSTRUCT-OPAQUE-STATE-CANDIDATE-RECORD", "category": "error", "given": "A value that is not carried as OpaqueValue.", "when": "Validation is performed.", "expect": {"error_code": "TYPE_SHAPE_MISMATCH", "result_absent": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-006/oracle.yaml"]},
    {"test_id": "DYN-006-CONSERVATION", "applies_to": "CONSTRUCT-OPAQUE-STATE-CANDIDATE-RECORD", "category": "serialization", "given": "A valid record is serialized and reconstructed losslessly.", "when": "The round trip completes.", "expect": {"keys_values_traceability_partial_status_unresolved_and_reservations_unchanged": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-006/oracle.yaml"]},
    {"test_id": "DYN-006-UNRESOLVED", "applies_to": "CONSTRUCT-OPAQUE-STATE-CANDIDATE-RECORD", "category": "preservation", "given": "A valid structural request.", "when": "The result is returned.", "expect": {"unresolved": ["TLC-UT-DYNAMICS-001", "TLC-UT-DYNAMICS-002", "TLC-UT-DYNAMICS-003", "TLC-UT-DYNAMICS-004", "TLC-UT-DYNAMICS-005", "TLC-UT-DYNAMICS-006", "TLC-UT-DYNAMICS-008", "TLC-UT-DYNAMICS-009", "TLC-UT-DYNAMICS-010", "TLC-UT-DYNAMICS-011", "TLC-UT-DYNAMICS-012"]}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-006/oracle.yaml", "registry/domain-finalization/dynamics/decision-required.yaml"]},
    {"test_id": "DYN-006-DETERMINISM", "applies_to": "CONSTRUCT-OPAQUE-STATE-CANDIDATE-RECORD", "category": "determinism", "given": "Identical mapping content and identical exposed order.", "when": "The operation is repeated.", "expect": {"structurally_identical_record": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-006/oracle.yaml"]},
    {"test_id": "DYN-006-METAMORPHIC-SUBSET", "applies_to": "CONSTRUCT-OPAQUE-STATE-CANDIDATE-RECORD", "category": "preservation", "given": "One valid component is removed from a valid candidate mapping.", "when": "The transformed mapping is packaged.", "expect": {"only_removed_component_absent": true, "partial_candidate_valid": true, "defaults_absent": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-006/oracle.yaml"]},
    {"test_id": "DYN-006-FORBIDDEN-SEMANTICS", "applies_to": "CONSTRUCT-OPAQUE-STATE-CANDIDATE-RECORD", "category": "unsupported_operation", "given": "A request for an explicit state space, default, completeness claim, transition, initial state, or terminal state.", "when": "The unsupported request is made.", "expect": {"error_code": "UNRESOLVED_SCIENTIFIC_SEMANTICS", "explicit_state_space_absent": true, "invented_default_absent": true, "completeness_claim_absent": true, "inferred_transition_absent": true, "initial_state_absent": true, "terminal_state_absent": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-006/oracle.yaml"]}
  ]
}
