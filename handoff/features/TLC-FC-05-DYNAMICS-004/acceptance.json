{
  "schema_version": "1.0", "package_version": "1.0.0", "applies_to": "TLC-FC-05-DYNAMICS-004",
  "tests": [
    {"test_id": "DYN-004-NOMINAL", "applies_to": "CONSTRUCT-SYMBOLIC-FEEDBACK-EXPRESSION", "category": "valid_input", "given": "An opaque external input, opaque kernel, and source-addressable parameters.", "when": "The structural operation is requested.", "expect": {"representation": "UnevaluatedIntegralExpression", "inputs_distinct_and_unchanged": true, "source_objects_and_relations_traceable": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-004/oracle.yaml", "registry/test-plans/TLC-FC-05-DYNAMICS-004/test-plan.yaml"]},
    {"test_id": "DYN-004-OPAQUE-KERNEL", "applies_to": "CONSTRUCT-SYMBOLIC-FEEDBACK-EXPRESSION", "category": "preservation", "given": "A kernel with no domain or convergence evidence.", "when": "The expression is constructed.", "expect": {"construction_succeeds": true, "kernel_opaque": true, "integral_evaluation_absent": true, "convergence_claim_absent": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-004/oracle.yaml"]},
    {"test_id": "DYN-004-UNKNOWN-PARAMETER", "applies_to": "CONSTRUCT-SYMBOLIC-FEEDBACK-EXPRESSION", "category": "error", "given": "A parameter source identifier outside the covered inventory.", "when": "Validation is performed.", "expect": {"error_code": "UNKNOWN_SOURCE_IDENTIFIER", "result_absent": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-004/oracle.yaml"]},
    {"test_id": "DYN-004-TYPE-SHAPE", "applies_to": "CONSTRUCT-SYMBOLIC-FEEDBACK-EXPRESSION", "category": "error", "given": "An invalid signal, kernel, or parameter-map carrier.", "when": "Validation is performed.", "expect": {"error_code": "TYPE_SHAPE_MISMATCH", "result_absent": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-004/oracle.yaml"]},
    {"test_id": "DYN-004-UNRESOLVED", "applies_to": "CONSTRUCT-SYMBOLIC-FEEDBACK-EXPRESSION", "category": "preservation", "given": "A valid structural request.", "when": "The result is returned.", "expect": {"unresolved": ["domains_and_convergence", "kernel_parameter_types"]}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-004/oracle.yaml", "registry/domain-finalization/dynamics/decision-required.yaml"]},
    {"test_id": "DYN-004-CONSERVATION", "applies_to": "CONSTRUCT-SYMBOLIC-FEEDBACK-EXPRESSION", "category": "serialization", "given": "A valid result is serialized and reconstructed losslessly.", "when": "The round trip completes.", "expect": {"signal_unchanged": true, "kernel_unchanged": true, "parameters_unchanged": true, "distinct_source_identities_preserved": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-004/oracle.yaml"]},
    {"test_id": "DYN-004-DETERMINISM", "applies_to": "CONSTRUCT-SYMBOLIC-FEEDBACK-EXPRESSION", "category": "determinism", "given": "Identical opaque inputs.", "when": "The operation is repeated.", "expect": {"structurally_identical_expression": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-004/oracle.yaml"]},
    {"test_id": "DYN-004-METAMORPHIC-KERNEL", "applies_to": "CONSTRUCT-SYMBOLIC-FEEDBACK-EXPRESSION", "category": "preservation", "given": "Only the opaque kernel payload is replaced while identifiers remain valid.", "when": "The transformed input is packaged.", "expect": {"only_kernel_payload_changes": true, "signal_parameters_traceability_and_unresolved_unchanged": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-004/oracle.yaml"]},
    {"test_id": "DYN-004-FORBIDDEN-SEMANTICS", "applies_to": "CONSTRUCT-SYMBOLIC-FEEDBACK-EXPRESSION", "category": "unsupported_operation", "given": "A request for a numeric integral, domain or parameter-type inference, convergence, or an executable transition.", "when": "The unsupported request is made.", "expect": {"error_code": "UNRESOLVED_SCIENTIFIC_SEMANTICS", "numeric_integral_absent": true, "convergence_claim_absent": true, "inferred_kernel_domain_absent": true, "inferred_parameter_type_absent": true, "executable_transition_absent": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-004/oracle.yaml"]}
  ]
}
