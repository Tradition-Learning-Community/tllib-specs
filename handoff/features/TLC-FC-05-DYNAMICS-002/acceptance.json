{
  "schema_version": "1.0", "package_version": "1.0.0", "applies_to": "TLC-FC-05-DYNAMICS-002",
  "tests": [
    {"test_id": "DYN-002-NOMINAL", "applies_to": "BUILD-UNEVALUATED-DYNAMICS-BUNDLE", "category": "valid_input", "given": "The eight covered opaque equation sources and a symbol table covering all cited identifiers.", "when": "The bundle operation is requested.", "expect": {"representation": "DynamicsBundle[OpaqueEquation]", "membership_equals_input": true, "order_equals_input": true, "payloads_and_classifications_preserved": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-002/oracle.yaml", "registry/test-plans/TLC-FC-05-DYNAMICS-002/test-plan.yaml"]},
    {"test_id": "DYN-002-OPAQUE-EQUATION", "applies_to": "BUILD-UNEVALUATED-DYNAMICS-BUNDLE", "category": "preservation", "given": "An equation with undefined state type or stochastic details.", "when": "The bundle is constructed.", "expect": {"equation_present": true, "opaque_payload_unchanged": true, "evaluation_absent": true, "distribution_absent": true, "initial_condition_absent": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-002/oracle.yaml"]},
    {"test_id": "DYN-002-MISSING-SYMBOL", "applies_to": "BUILD-UNEVALUATED-DYNAMICS-BUNDLE", "category": "error", "given": "An equation references a symbol absent from the supplied symbol table.", "when": "Validation is performed.", "expect": {"error_code": "UNKNOWN_SOURCE_IDENTIFIER", "partial_bundle_absent": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-002/oracle.yaml"]},
    {"test_id": "DYN-002-TYPE-SHAPE", "applies_to": "BUILD-UNEVALUATED-DYNAMICS-BUNDLE", "category": "error", "given": "A non-sequence equation carrier, invalid equation record, or invalid symbol-table carrier.", "when": "Validation is performed.", "expect": {"error_code": "TYPE_SHAPE_MISMATCH", "result_absent": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-002/oracle.yaml"]},
    {"test_id": "DYN-002-ORDER", "applies_to": "BUILD-UNEVALUATED-DYNAMICS-BUNDLE", "category": "output_contract", "given": "Any permutation of valid opaque equation records.", "when": "The bundle is constructed.", "expect": {"supplied_order_reproduced": true, "canonical_reordering_absent": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-002/oracle.yaml"]},
    {"test_id": "DYN-002-UNRESOLVED", "applies_to": "BUILD-UNEVALUATED-DYNAMICS-BUNDLE", "category": "preservation", "given": "A valid structural request.", "when": "The result is returned.", "expect": {"unresolved": ["types_initial_conditions_stochastic_details", "solver_and_discretization"]}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-002/oracle.yaml", "registry/domain-finalization/dynamics/decision-required.yaml"]},
    {"test_id": "DYN-002-DETERMINISM", "applies_to": "BUILD-UNEVALUATED-DYNAMICS-BUNDLE", "category": "determinism", "given": "Identical ordered opaque equations and symbols.", "when": "The operation is repeated.", "expect": {"structurally_identical_bundle": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-002/oracle.yaml"]},
    {"test_id": "DYN-002-METAMORPHIC-PAYLOAD", "applies_to": "BUILD-UNEVALUATED-DYNAMICS-BUNDLE", "category": "preservation", "given": "One equation payload is replaced while its identifiers and position are retained.", "when": "The transformed sequence is packaged.", "expect": {"only_replaced_payload_changes": true, "all_other_structure_and_metadata_unchanged": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-002/oracle.yaml"]},
    {"test_id": "DYN-002-FORBIDDEN-SEMANTICS", "applies_to": "BUILD-UNEVALUATED-DYNAMICS-BUNDLE", "category": "unsupported_operation", "given": "A request to solve, discretize, initialize, sample, select a distribution, or execute transitions.", "when": "The unsupported request is made.", "expect": {"error_code": "UNRESOLVED_SCIENTIFIC_SEMANTICS", "solved_trajectory_absent": true, "solver_absent": true, "time_step_absent": true, "initial_condition_absent": true, "probability_distribution_absent": true, "executable_transition_absent": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-002/oracle.yaml"]}
  ]
}
