{
  "schema_version": "1.0",
  "package_version": "1.0.0",
  "applies_to": "TLC-FC-07-MESSAGE-002",
  "tests": [
    {"test_id": "MSG-002-A01", "applies_to": "REGISTER-MESSAGE-PREEXISTENCE-CLAIM", "category": "valid_input", "given": {"object_id": "TLC-SO-MESSAGE-013", "evaluation_requested": false}, "when": "The claim is registered from unchanged source evidence.", "expect": {"verification_status": "unavailable_without_oracle", "truth_value_present": false, "executable_oracle_present": false}, "source_basis": ["registry/oracles/message/TLC-FC-07-MESSAGE-002/oracle.yaml"]},
    {"test_id": "MSG-002-A02", "applies_to": "REGISTER-MESSAGE-PREEXISTENCE-CLAIM", "category": "invalid_input", "given": "The required identity or source range is missing or changed.", "when": "Input validation runs.", "expect": {"error": "MissingPreexistenceEvidence", "partial_result": false}, "source_basis": ["registry/oracles/message/TLC-FC-07-MESSAGE-002/oracle.yaml"]},
    {"test_id": "MSG-002-A03", "applies_to": "REGISTER-MESSAGE-PREEXISTENCE-CLAIM", "category": "unsupported_operation", "given": "Scientific evaluation or a truth value is requested.", "when": "The request is processed.", "expect": {"error": "OracleEvaluationRequested", "partial_result": false}, "source_basis": ["registry/oracles/message/TLC-FC-07-MESSAGE-002/oracle.yaml"]},
    {"test_id": "MSG-002-A04", "applies_to": "REGISTER-MESSAGE-PREEXISTENCE-CLAIM", "category": "preservation", "given": "Evidence includes an opaque statement and source reference.", "when": "The claim is returned.", "expect": "Statement reference, opaque payload, object identity, and source range are unchanged.", "source_basis": ["registry/oracles/message/TLC-FC-07-MESSAGE-002/oracle.yaml"]},
    {"test_id": "MSG-002-A05", "applies_to": "REGISTER-MESSAGE-PREEXISTENCE-CLAIM", "category": "output_contract", "given": "Valid candidate evidence is supplied.", "when": "The result metadata is inspected.", "expect": {"candidate_status": "unevaluated_candidate", "verification_status": "unavailable_without_oracle"}, "source_basis": ["registry/oracles/message/TLC-FC-07-MESSAGE-002/oracle.yaml"]},
    {"test_id": "MSG-002-A06", "applies_to": "REGISTER-MESSAGE-PREEXISTENCE-CLAIM", "category": "determinism", "given": "Two invocations receive identical evidence.", "when": "Both succeed.", "expect": "The semantic claim records are structurally equal.", "source_basis": ["registry/optimized-ir/message/TLC-FC-07-MESSAGE-002/ir.yaml"]},
    {"test_id": "MSG-002-A07", "applies_to": "REGISTER-MESSAGE-PREEXISTENCE-CLAIM", "category": "serialization", "given": "A conforming implementation performs a structural serialization round trip.", "when": "The round-tripped claim is inspected.", "expect": "Unavailable status, identity, provenance, source range, candidate status, and opaque values are preserved; no canonical format is required.", "source_basis": ["registry/oracles/message/TLC-FC-07-MESSAGE-002/oracle.yaml"]},
    {"test_id": "MSG-002-A08", "applies_to": "REGISTER-MESSAGE-PREEXISTENCE-CLAIM", "category": "invariant", "given": "The package is used without an external scientific provider.", "when": "The claim is inspected.", "expect": "Ontology, time model, existence predicate, truth value, and scientific oracle remain absent and unresolved.", "source_basis": ["registry/domain-finalization/message/decision-required.yaml"]}
  ]
}