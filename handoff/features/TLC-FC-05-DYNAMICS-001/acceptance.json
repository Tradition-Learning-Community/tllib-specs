{
  "schema_version": "1.0",
  "package_version": "1.0.0",
  "applies_to": "TLC-FC-05-DYNAMICS-001",
  "tests": [
    {"test_id": "DYN-001-NOMINAL", "applies_to": "EVALUATE-VIABILITY-PREDICATES-SYMBOLICALLY", "category": "valid_input", "given": "An opaque Community state and source-addressable opaque bounds for the four source-defined predicates.", "when": "The structural operation is requested.", "expect": {"representation": "UnevaluatedPredicateSet", "predicate_count": 4, "distinct": true, "traceability": ["TLC-SO-DYNAMICS-015", "TLC-SR-DYNAMICS-014"], "source_order_preserved": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-001/oracle.yaml", "registry/test-plans/TLC-FC-05-DYNAMICS-001/test-plan.yaml"]},
    {"test_id": "DYN-001-OPAQUE-BOUNDARY", "applies_to": "EVALUATE-VIABILITY-PREDICATES-SYMBOLICALLY", "category": "preservation", "given": "Bound payloads for which numerical comparison is not permitted.", "when": "The predicates are packaged.", "expect": {"construction_succeeds": true, "payloads_unchanged": true, "truth_value_absent": true, "aggregate_boolean_absent": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-001/oracle.yaml"]},
    {"test_id": "DYN-001-UNKNOWN-SOURCE", "applies_to": "EVALUATE-VIABILITY-PREDICATES-SYMBOLICALLY", "category": "error", "given": "One predicate or bound source identifier is unknown.", "when": "Validation is performed.", "expect": {"error_code": "UNKNOWN_SOURCE_IDENTIFIER", "result_absent": true, "partial_set_absent": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-001/oracle.yaml"]},
    {"test_id": "DYN-001-TYPE-SHAPE", "applies_to": "EVALUATE-VIABILITY-PREDICATES-SYMBOLICALLY", "category": "error", "given": "The Community-state or bounds carrier has the wrong declared shape.", "when": "Validation is performed.", "expect": {"error_code": "TYPE_SHAPE_MISMATCH", "result_absent": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-001/oracle.yaml"]},
    {"test_id": "DYN-001-UNRESOLVED", "applies_to": "EVALUATE-VIABILITY-PREDICATES-SYMBOLICALLY", "category": "preservation", "given": "A valid structural request.", "when": "The result is constructed.", "expect": {"unresolved": ["UNRES-TIME", "UNRES-L", "UNRES-NORM", "UNRES-MEMORY-NOTATION", "UNRES-OUTPUT"]}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-001/oracle.yaml", "registry/domain-finalization/dynamics/decision-required.yaml"]},
    {"test_id": "DYN-001-DETERMINISM", "applies_to": "EVALUATE-VIABILITY-PREDICATES-SYMBOLICALLY", "category": "determinism", "given": "Identical ordered opaque inputs.", "when": "The operation is repeated.", "expect": {"structurally_identical_output": true, "identical_traceability": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-001/oracle.yaml"]},
    {"test_id": "DYN-001-METAMORPHIC-OPAQUE", "applies_to": "EVALUATE-VIABILITY-PREDICATES-SYMBOLICALLY", "category": "preservation", "given": "One opaque scalar payload is replaced while identifiers and position are retained.", "when": "The transformed input is packaged.", "expect": {"only_corresponding_payload_changes": true, "identities_unchanged": true, "order_unchanged": true, "metadata_unchanged": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-001/oracle.yaml"]},
    {"test_id": "DYN-001-FORBIDDEN-SEMANTICS", "applies_to": "EVALUATE-VIABILITY-PREDICATES-SYMBOLICALLY", "category": "unsupported_operation", "given": "A request for numerical viability, aggregate truth, collapse, or terminal-state semantics.", "when": "The unsupported request is made.", "expect": {"error_code": "UNRESOLVED_SCIENTIFIC_SEMANTICS", "numeric_viability_result_absent": true, "boolean_aggregation_absent": true, "collapse_transition_absent": true, "terminal_state_absent": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-001/oracle.yaml"]}
  ]
}
