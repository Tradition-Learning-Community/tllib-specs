    {"test_id": "DYN-007-UNRESOLVED", "applies_to": "PRESERVE-STATE-OR-EVOLUTION-EXPRESSION", "category": "preservation", "given": "A valid structural request.", "when": "The result is returned.", "expect": {"unresolved": ["TLC-UT-DYNAMICS-007", "state_vs_evolution_boundary"]}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-007/oracle.yaml", "registry/domain-finalization/dynamics/decision-required.yaml"]},
