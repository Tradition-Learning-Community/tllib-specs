    {"test_id": "DYN-007-DETERMINISM", "applies_to": "PRESERVE-STATE-OR-EVOLUTION-EXPRESSION", "category": "determinism", "given": "Identical expression and hint.", "when": "The operation is repeated.", "expect": {"structurally_identical_node": true, "seed_not_used": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-007/oracle.yaml"]},
