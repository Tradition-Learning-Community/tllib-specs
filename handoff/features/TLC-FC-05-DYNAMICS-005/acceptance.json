{
  "schema_version": "1.0", "package_version": "1.0.0", "applies_to": "TLC-FC-05-DYNAMICS-005",
  "tests": [
    {"test_id": "DYN-005-NOMINAL", "applies_to": "CONSTRUCT-OPAQUE-INTERACTION-APPLICATION", "category": "valid_input", "given": "A source-listed operator and ordered opaque Master, Disciple, or Community references.", "when": "The structural operation is requested.", "expect": {"representation": "UnevaluatedOperatorApplication", "operator_identity_preserved": true, "argument_identities_preserved": true, "argument_order_preserved": true, "traceability": ["TLC-SO-DYNAMICS-014", "TLC-SR-DYNAMICS-013"]}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-005/oracle.yaml", "registry/test-plans/TLC-FC-05-DYNAMICS-005/test-plan.yaml"]},
    {"test_id": "DYN-005-OPAQUE-SIGNATURE", "applies_to": "CONSTRUCT-OPAQUE-INTERACTION-APPLICATION", "category": "preservation", "given": "No operator signature or return type.", "when": "The application is constructed.", "expect": {"construction_succeeds": true, "arity_absent": true, "parameter_types_absent": true, "codomain_absent": true, "result_semantics_absent": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-005/oracle.yaml"]},
    {"test_id": "DYN-005-UNKNOWN-OPERATOR", "applies_to": "CONSTRUCT-OPAQUE-INTERACTION-APPLICATION", "category": "error", "given": "An operator ID absent from the source-listed set.", "when": "Validation is performed.", "expect": {"error_code": "UNKNOWN_SOURCE_IDENTIFIER", "result_absent": true, "arguments_unchanged": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-005/oracle.yaml"]},
    {"test_id": "DYN-005-TYPE-SHAPE", "applies_to": "CONSTRUCT-OPAQUE-INTERACTION-APPLICATION", "category": "error", "given": "Arguments are not carried as Sequence[OpaqueEntityRef].", "when": "Validation is performed.", "expect": {"error_code": "TYPE_SHAPE_MISMATCH", "result_absent": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-005/oracle.yaml"]},
    {"test_id": "DYN-005-ORDER", "applies_to": "CONSTRUCT-OPAQUE-INTERACTION-APPLICATION", "category": "output_contract", "given": "Any valid supplied argument ordering.", "when": "The application is constructed.", "expect": {"supplied_order_reproduced": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-005/oracle.yaml"]},
    {"test_id": "DYN-005-UNRESOLVED", "applies_to": "CONSTRUCT-OPAQUE-INTERACTION-APPLICATION", "category": "preservation", "given": "A valid structural request.", "when": "The result is returned.", "expect": {"unresolved": ["operator_signatures_absent", "community_symbol_reconciliation"]}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-005/oracle.yaml", "registry/domain-finalization/dynamics/decision-required.yaml"]},
    {"test_id": "DYN-005-DETERMINISM", "applies_to": "CONSTRUCT-OPAQUE-INTERACTION-APPLICATION", "category": "determinism", "given": "An identical operator and identical ordered arguments.", "when": "The operation is repeated.", "expect": {"structurally_identical_application": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-005/oracle.yaml"]},
    {"test_id": "DYN-005-METAMORPHIC-ARGUMENT", "applies_to": "CONSTRUCT-OPAQUE-INTERACTION-APPLICATION", "category": "preservation", "given": "One valid opaque argument is replaced while retaining its position.", "when": "The transformed input is packaged.", "expect": {"only_replaced_argument_changes": true, "operator_and_other_arguments_unchanged": true, "traceability_and_unresolved_unchanged": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-005/oracle.yaml"]},
    {"test_id": "DYN-005-FORBIDDEN-SEMANTICS", "applies_to": "CONSTRUCT-OPAQUE-INTERACTION-APPLICATION", "category": "unsupported_operation", "given": "A request for inferred arity, return type, evaluated interaction, derivative update, or executable transition.", "when": "The unsupported request is made.", "expect": {"error_code": "UNRESOLVED_SCIENTIFIC_SEMANTICS", "inferred_arity_absent": true, "inferred_return_type_absent": true, "evaluated_interaction_absent": true, "derivative_update_absent": true, "executable_transition_absent": true}, "source_basis": ["registry/oracles/dynamics/TLC-FC-05-DYNAMICS-005/oracle.yaml"]}
  ]
}
