    {"test_id": "HC-FID-003", "applies_to": "round trip", "category": "preservation", "given": {"value": "TLC-FC-00-MASTER-005"}, "when": "The identifier crosses a conforming transport boundary and returns.", "expect": {"exactly_equal": true}}
